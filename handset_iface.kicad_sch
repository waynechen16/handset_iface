  (text "Gain: R8 = 10k fixed + RV2 (0~100k)\n=> Av = 1 + (10k~110k)/2.2k = 5.5 ~ 51  (15~34 dB)\nC9 limits HF / RF pickup\nC10 sets LF corner: 1/(2*pi*2.2k*22u) = 3.3 Hz" (at 106.68 160.02 0)
    (effects (font (size 1.2 1.2)) (justify left bottom))
    (uuid e5fe55b3-6131-4fd5-8e6c-235c4ca6022f)
